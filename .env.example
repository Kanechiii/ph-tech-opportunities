# PH Tech Opportunities Automation
# Copy this file to .env when configuring your local environment.
# Never place actual passwords or tokens in this example file.

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail authentication
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=your_app_password_here

# Notification recipient
RECIPIENT_EMAIL=recipient@gmail.com

# Application configuration
APP_NAME=PH Tech Opportunities Automation
APP_TIMEZONE=Asia/Manila
APP_ENV=development